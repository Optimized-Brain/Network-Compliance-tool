# .env file for Network Compliance Checker
# Copy this to .env and customize

# Mode: "demo" for testing, "live" for real SSH connections
COMPLIANCE_MODE=demo

# Web server port
PORT=5000

# Max concurrent SSH sessions
MAX_SSH_WORKERS=10

# Flask secret key (change in production!)
SECRET_KEY=change-this-to-a-random-string

# Debug mode (set to 1 for development)
FLASK_DEBUG=0
